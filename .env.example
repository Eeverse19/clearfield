# Copy to .env and fill in. Never commit .env.
# Meta Model API key (dev.meta.ai) for Spark + SAM 3.1. Optional for the scaffold:
# endpoints that need it return 501 until it is set.
META_API_KEY=
# PostGIS target (later). Leave blank for the local-DB scaffold.
DATABASE_URL=
# Local DB first (scaffold default): SQLite file created by scripts/seed_db.ps1.
CLEARFIELD_LOCAL_DB=data/clearfield.db
